# Canvas Studio 설정 예시. 복사해서 app\.env로 쓰고, .env는 커밋하지 않는다(.gitignore 등록).
# 값을 비워 두면 괄호 안의 기본값을 쓴다.

# 편집기(브라우저)가 붙을 협업 서버 주소 (http://127.0.0.1:8787)
VITE_COLLAB_URL=

# 협업 서버가 들을 주소·포트 (127.0.0.1 / 8787). 다른 PC에서 접속하게 하려면 COLLAB_HOST를 바꾸고 방화벽을 연다.
COLLAB_HOST=
COLLAB_PORT=
# 계정·파일 저장 위치 (%APPDATA%\CanvasStudio\server)
COLLAB_DATA_DIR=
# 로그 위치 (%LOCALAPPDATA%\CanvasStudio\logs), 30일 지나면 지운다
COLLAB_LOG_DIR=
# 서버에 붙을 수 있는 편집기 주소, 쉼표로 구분 (http://127.0.0.1:5173,http://localhost:5173)
COLLAB_ALLOWED_ORIGINS=
# 로그인 유지 시간(시간) (168)
COLLAB_SESSION_HOURS=
